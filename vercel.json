{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,

  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },

  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index.php"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/style.css",
      "destination": "/style.css"
    }
  ]
}